# Database
# For local development (with docker-compose.dev.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/microcrm?schema=public"
# For Docker production (docker-compose.yml uses this internally):
# DATABASE_URL="postgresql://postgres:postgres@db:5432/microcrm?schema=public"

# JWT Authentication
JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-base64-32"

# Application
NODE_ENV="development"

# Docker Compose PostgreSQL settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="microcrm"
