    "helmet": "^8.1.0",
    "jalaali-js": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jalaali-js": "^1.2.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "20.17.57",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.4.2",
    "eslint": "9.28.0",
    "fast-check": "^4.9.0",
    "supertest": "^7.1.0",
    "tsx": "^4.23.0",
